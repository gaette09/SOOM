# Real personal FIT/GPX/TCX fixtures used for local ad hoc parser verification
# (e.g. real GPS routes) — never committed. Synthetic fixtures built in test
# code (FITTestFileBuilder etc.) are unaffected, they aren't files on disk.
SOOMTests/Fixtures/

# Supabase CLI scratch state from `supabase link`/`db push` — includes a
# pooler connection string, never committed.
supabase/.temp/

# APNs auth keys and env files used to load Supabase Edge Function
# secrets (notify-feed-interaction) — never committed, always loaded
# from outside the repo (see SOOM-OS/CLAUDE.md for the path).
*.p8
*.env
