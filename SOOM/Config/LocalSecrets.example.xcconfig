// Copy this file to LocalSecrets.xcconfig and keep the copy out of git.
// Do not commit real token values.

MBX_ACCESS_TOKEN=pk.your_mapbox_token_here
OPENWEATHER_API_KEY=your_openweather_key_here
// xcconfig treats // as a comment start, so a plain https://... value gets
// silently truncated to "https:" — insert $() between the slashes to escape it.
SOOM_SUPABASE_URL=https:/$()/your-project-ref.supabase.co
SOOM_SUPABASE_ANON_KEY=your_supabase_anon_key_here
