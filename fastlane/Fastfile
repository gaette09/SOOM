default_platform(:ios)

platform :ios do
  desc "Build SOOM archive locally without uploading"
  lane :archive do
    build_app(
      project: "SOOM.xcodeproj",
      scheme: "SOOM",
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      output_directory: "build",
      output_name: "SOOM.ipa",
      skip_package_ipa: true,
      build_path: "build/archive"
    )
  end

  desc "Build SOOM IPA and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH"))
    )

    build_app(
      project: "SOOM.xcodeproj",
      scheme: "SOOM",
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      output_directory: "build",
      output_name: "SOOM.ipa",
      build_path: "build/archive"
    )

    upload_to_testflight(
      ipa: "build/SOOM.ipa",
      app_identifier: "app.soom.prototype",
      team_id: "82D59P8SDL",
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
